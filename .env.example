# Enterprise Agent OS local settings

DB_PASSWORD=change-me-now
AEGIS_DATABASE_URL=postgresql://enterprise:change-me-now@postgres:5432/enterprise_agents
PAPERCLIP_DATABASE_URL=postgresql://enterprise:change-me-now@postgres:5432/paperclip
DASHBOARD_ADMIN_EMAIL=admin@enterprise.local
DASHBOARD_ADMIN_PASSWORD=change-me-now

# Paperclip should be cloned next to this repo by default.
# Override if your checkout lives elsewhere.
PAPERCLIP_CONTEXT=../../paperclip
PAPERCLIP_API_KEY=change-me-now
PAPERCLIP_WEBHOOK_SECRET=change-me-now

# Service API keys
AGENT_RUNTIME_API_KEY=change-me-now
SECURITY_LAYER_API_KEY=change-me-now
MCP_HUB_API_KEY=change-me-now
DASHBOARD_API_KEY=change-me-now

# Local model backends
DEFAULT_LLM=ollama
OLLAMA_MODEL=llama3.1:8b
DEFAULT_AGENT_MODEL=llama3.1:8b
VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
VLLM_GPU_COUNT=1
VLLM_MAX_LEN=32768
VLLM_GPU_MEM=0.90
HF_TOKEN=

# Optional external providers. Keep disabled by policy unless explicitly enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LOG_LEVEL=info
